# BwanaPay Anchor Platform Environment Configuration
# Copy this file to 'dev.env' and fill in your actual values

# Stellar Anchor Configuration
STELLAR_ANCHOR_CONFIG=/home/dev.services.yaml

# Server Ports
PLATFORM_SERVER_PORT=8085
BUSINESS_SERVER_PORT=8081

# Database Configuration
SECRET_DATA_USERNAME=postgres
SECRET_DATA_PASSWORD=your_secure_db_password_here
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password_here

# JWT Secrets (Generate your own secure secrets)
SECRET_SEP10_SIGNING_SEED=your_stellar_signing_seed_here
SECRET_SEP10_JWT_SECRET=your_jwt_secret_here
SESSION_JWT_SECRET=your_session_secret_here
SECRET_SEP24_INTERACTIVE_URL_JWT_SECRET=your_interactive_secret_here
SECRET_SEP24_MORE_INFO_URL_JWT_SECRET=your_more_info_secret_here
SECRET_PLATFORM_API_AUTH_SECRET=your_platform_auth_secret_here

# Database Connection
DATABASE_URL=postgres://postgres:your_secure_db_password_here@db:5432/postgres

# Business Server Configuration
BUSINESS_SERVER_URL=http://business-server:8081

# To generate secure secrets, use:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"