STELLAR_ANCHOR_CONFIG=/home/dev.services.yaml
PLATFORM_SERVER_PORT=8085
PLATFORM_API_BASE_URL=http://platform-server:8085
BUSINESS_SERVER_PORT=8081
PUBLIC_ANCHOR_BASE_URL=http://YOUR_PC_LAN_IP:8080

ASSETS_TYPE=file
ASSETS_VALUE=/home/dev.assets.yaml
DATA_TYPE=postgres
DATA_SERVER=db
DATA_DATABASE=platform
DATA_FLYWAY_ENABLED=true

SECRET_DATA_USERNAME=postgres
SECRET_DATA_PASSWORD=replace-me
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me

PLATFORM_API_AUTH_TYPE=jwt
LOGGING_LEVEL_ORG_STELLAR=DEBUG
SECRET_PLATFORM_API_AUTH_SECRET=replace-me
PLATFORM_API_AUTH_EXCLUDE_PATHS="/.well-known/stellar.toml"

SEP1_ENABLED=true
SEP1_TOML_TYPE=file
SEP1_TOML_VALUE=/home/dev.stellar.toml

SEP10_ENABLED=true
SEP10_HOME_DOMAIN=YOUR_PC_LAN_IP:8080
SECRET_SEP10_SIGNING_SEED=replace-me-testnet-seed
SECRET_SEP10_JWT_SECRET=replace-me
SECRET_STELLAR_DEMO_SOURCE_SEED=replace-me-testnet-seed
SECRET_STELLAR_DEMO_USDC_ISSUER_SEED=replace-me-testnet-issuer-seed
STELLAR_DEMO_USDC_ISSUER_ACCOUNT=replace-me-testnet-issuer-public-key

SESSION_JWT_SECRET=replace-me

SEP24_ENABLED=true
SEP24_INTERACTIVE_URL_BASE_URL=http://YOUR_PC_LAN_IP:8080/sep24
SEP24_MORE_INFO_URL_BASE_URL=http://YOUR_PC_LAN_IP:8080/sep24/info
SECRET_SEP24_INTERACTIVE_URL_JWT_SECRET=replace-me
SECRET_SEP24_MORE_INFO_URL_JWT_SECRET=replace-me
SEP24_INITIAL_USER_DEADLINE_SECONDS=1209600

DEMO_ZMW_PER_USDC=28
ENABLE_DEMO_ENDPOINTS=true
DEMO_API_KEY=replace-me-demo-api-key
